{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "User profile containing XP, streak, tasks, classes, and apps for persistence.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID of the student matching request.auth.uid"
        },
        "email": {
          "type": "string",
          "description": "Google email address of the student"
        },
        "xp": {
          "type": "integer",
          "description": "XP reward progress points"
        },
        "streak": {
          "type": "integer",
          "description": "Consecutive dynamic log days"
        },
        "subjects": {
          "type": "array",
          "description": "Registered academic subjects list"
        },
        "tasks": {
          "type": "array",
          "description": "Workspace study tasks with AI recommendations"
        },
        "classes": {
          "type": "array",
          "description": "Zoom or study schedules log"
        },
        "apps": {
          "type": "array",
          "description": "Integrated companion launchpad keys"
        },
        "papers": {
          "type": "array",
          "description": "User uploaded past papers and worksheet evaluation records"
        },
        "deepseekApiKey": {
          "type": "string",
          "description": "User custom DeepSeek API key for personalized AI reasoning"
        },
        "customDns": {
          "type": "string",
          "description": "User custom private DNS host"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name"
        },
        "habits": {
          "type": "array",
          "description": "User custom study and routine habit items"
        },
        "habitLogs": {
          "type": "object",
          "description": "Daily habit completion checkboxes and mood/sleep metrics"
        },
        "habitStartDate": {
          "type": "string",
          "description": "Starting anchor date for habit tracking matrix"
        },
        "exams": {
          "type": "array",
          "description": "Student exam countdown schedule items with date, time, subject, and notes"
        },
        "friends": {
          "type": "array",
          "description": "Study buddies and mutual focus leaderboard connections"
        },
        "friendUsername": {
          "type": "string",
          "description": "User personalized public handle for study buddy invitations"
        },
        "inviteCode": {
          "type": "string",
          "description": "Unique invite code for friend connection links"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was modified"
        }
      },
      "required": ["uid", "email"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public discoverable student profile for study buddy matching and friend requests.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase user UID"
        },
        "username": {
          "type": "string",
          "description": "Unique handle e.g. @ahmed_chem"
        },
        "displayName": {
          "type": "string",
          "description": "Student display name"
        },
        "email": {
          "type": "string",
          "description": "Student email address"
        },
        "inviteCode": {
          "type": "string",
          "description": "Unique 6-8 char student invitation code"
        },
        "totalFocusMinutes": {
          "type": "integer",
          "description": "Total authenticated study focus minutes logged"
        },
        "streak": {
          "type": "integer",
          "description": "Consecutive days study streak"
        },
        "fiveDigitCode": {
          "type": "string",
          "description": "5-digit numeric friend code"
        },
        "focusMinutesThisWeek": {
          "type": "integer",
          "description": "Minutes studied during the current week"
        },
        "currentWeekId": {
          "type": "string",
          "description": "Week identifier e.g. 2026-W43"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Cross-user live friend invitation between actual students.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Request identifier combining sender and recipient"
        },
        "fromUserId": {
          "type": "string",
          "description": "Sender UID"
        },
        "fromUsername": {
          "type": "string",
          "description": "Sender @handle"
        },
        "fromDisplayName": {
          "type": "string",
          "description": "Sender display name"
        },
        "fromCode": {
          "type": "string",
          "description": "Sender 5-digit friend code"
        },
        "fromFocusMinutes": {
          "type": "integer",
          "description": "Sender focus minutes reading"
        },
        "fromStreak": {
          "type": "integer",
          "description": "Sender streak"
        },
        "toUserId": {
          "type": "string",
          "description": "Recipient UID"
        },
        "toUsername": {
          "type": "string",
          "description": "Recipient @handle"
        },
        "toDisplayName": {
          "type": "string",
          "description": "Recipient display name"
        },
        "toCode": {
          "type": "string",
          "description": "Recipient 5-digit friend code"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"],
          "description": "Request state"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "fromUserId", "toUserId", "status"]
    },
    "StudyRoom": {
      "title": "StudyRoom",
      "description": "Collaborative study room where students study together and view weekly leaderboards.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique room ID"
        },
        "name": {
          "type": "string",
          "description": "Room name"
        },
        "code": {
          "type": "string",
          "description": "5-digit numeric room code"
        },
        "subject": {
          "type": "string",
          "description": "Room study topic or subject"
        },
        "description": {
          "type": "string"
        },
        "creatorId": {
          "type": "string",
          "description": "UID of the student who created the room"
        },
        "creatorName": {
          "type": "string"
        },
        "weeklyGoalMinutes": {
          "type": "integer",
          "description": "Weekly target study minutes for the squad"
        },
        "memberIds": {
          "type": "array",
          "description": "List of user UIDs of members in the room"
        },
        "members": {
          "type": "array",
          "description": "List of member objects with names, codes, and weekly minutes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "code", "creatorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserWorkspace",
      "description": "Main document that persists all study portal workspace criteria for a single student."
    },
    "/user_profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Public student profile index for searching buddies by username or invite code."
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Live cross-user friend requests delivered in real time."
    },
    "/study_rooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Collaborative study rooms where students and family can study together and view weekly leaderboards."
    }
  }
}
